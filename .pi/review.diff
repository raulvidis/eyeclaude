+"""Tests for SharedState terminal cleanup."""
+
+import psutil
+
+import pytest
+from eyeclaude.shared_state import SharedState, Quadrant, TerminalInfo
+
+
+def test_prune_stale_terminals_removes_unreachable_processes(mocker):
+    """Terminals whose PID is no longer alive must be removed."""
+    ss = SharedState()
+
+    # Use a real PID on the system to avoid real-pid-side-effects in the mock
+    import psutil
+    real_pids = [p.pid for p in psutil.process_iter() if p.pid < 10000]
+    assert len(real_pids) >= 2, "Need at least 2 real PIDs under 10000"
+    alive_pid = real_pids[0]
+    dead_pid = real_pids[1] + 100000  # definitely not a real PID
+
+    ss._terminals = {
+        alive_pid: TerminalInfo(pid=alive_pid, window_handle=100, quadrant=Quadrant.TOP_LEFT),
+        dead_pid: TerminalInfo(pid=dead_pid, window_handle=200, quadrant=Quadrant.BOTTOM_RIGHT),
+    }
+
+    # alive_pid exists, dead_pid does not
+    mocker.patch(
+        "psutil.pid_exists",
+        side_effect=lambda p: p == alive_pid,
+    )
+    # Both HWNDs are valid (to isolate the PID check)
+    mocker.patch("win32gui.IsWindow", return_value=True)
+
+    stale = ss.prune_stale_terminals()
+
+    assert alive_pid in ss._terminals, "Alive terminal should remain"
+    assert dead_pid not in ss._terminals, "Dead terminal should be pruned"
+    assert 2 not in ss._terminals, "Dead terminal should be pruned"
+
+
+def test_prune_stale_terminals_noop_when_all_alive(mocker):
+    """No terminals are removed when all PIDs are still alive."""
+    ss = SharedState()
+
+    import psutil
+    real_pids = [p.pid for p in psutil.process_iter() if p.pid < 10000]
+    assert len(real_pids) >= 2, "Need at least 2 real PIDs under 10000"
+
+    ss._terminals = {
+        real_pids[0]: TerminalInfo(pid=real_pids[0], window_handle=100, quadrant=Quadrant.TOP_LEFT),
+        real_pids[1]: TerminalInfo(pid=real_pids[1], window_handle=200, quadrant=Quadrant.BOTTOM_RIGHT),
+    }
+
+    # Both PIDs are real and alive
+    mocker.patch("psutil.pid_exists", return_value=True)
+    # Both HWNDs are valid (to isolate the PID check)
+    mocker.patch("win32gui.IsWindow", return_value=True)
+    ss.prune_stale_terminals()
+
+    assert real_pids[0] in ss._terminals
+    assert real_pids[1] in ss._terminals
+    assert len(ss._terminals) == 2
+
+
+def test_prune_stale_terminals_removes_dead_hwnd(mocker):
+    """A terminal whose PID is alive but HWND is no longer a valid window
+    must be removed."""
+    ss = SharedState()
+
+    ss._terminals = {
+        12345: TerminalInfo(pid=12345, window_handle=100, quadrant=Quadrant.TOP_LEFT),
+        67890: TerminalInfo(pid=67890, window_handle=200, quadrant=Quadrant.BOTTOM_RIGHT),
+    }
+
+    # Both PIDs alive, but HWND 100 is dead, HWND 200 is alive
+    mocker.patch("psutil.pid_exists", return_value=True)
+    iswindow_mock = mocker.patch("win32gui.IsWindow", side_effect=lambda h: h == 200)
+
+    stale = ss.prune_stale_terminals()
+
+    assert 12345 in stale, "Dead-HWND terminal should be pruned"
+    assert len(ss._terminals) == 1
+    assert 67890 in ss._terminals, "Alive-HWND terminal should remain"
